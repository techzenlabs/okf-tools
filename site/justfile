# The site recipes, identical in every tenant because they ship from
# okf-tools. `okf-assemble` rewrites this file on every run, so a fix reaches
# four tenants by rolling one flake input forward rather than by four commits.
#
# Nothing here holds a credential. The CI job fetches the bundles and drops
# its tokens before it reaches `just build`, so a template bug has nothing to
# exfiltrate.

set shell := ["bash", "-euo", "pipefail", "-c"]

# Assemble, scan, render and index. The whole build.
#
# The scan is pointed at the assembled site *root*, not at `content`. A
# `content`-only scan never reads `static/` or `layouts/`, and those are where
# the shared assets land -- a stylesheet Hugo byte-copies into `public/` and a
# layout set rendered into every page. A comment in either publishes, and for
# as long as this recipe read `okf-scan content` nothing in the estate
# inspected them on the run that shipped them.
#
# `public/` is excluded because it is last run's output sitting in the tree
# when this run's scan happens, and re-reading it would attribute a finding to
# a path this build did not produce. The sources are what this scan judges.
#
# `work/` is excluded because Hugo never reads it. `okf-assemble` fetches the
# bundle sources into it and assembles `content/` out of it, so everything
# that publishes is already inspected under `content/`. Scanning it instead
# holds every bundle's test fixtures and CI scripts to the site's scanner:
# ria went red on a support-bundle redaction fixture asserting that a
# synthetic token gets stripped, in a script the site does not publish.
# Both exclusions are printed by every run, so neither is silent.
build:
    okf-assemble
    okf-scan . --exclude public --exclude work
    hugo
    okf-assemble --verify-raw
    pagefind --site public

# The same pipeline against a working tree, for authoring. `--local` is an
# argument and is never written to site.toml: when a working tree and the
# pinned rev disagree, the manifest wins.
serve *ARGS:
    okf-assemble {{ ARGS }}
    hugo server --bind 127.0.0.1 --port 1313 --disableFastRender

# Every gate this repository has.
check:
    nix flake check

# The assembled bundle as one file, for an agent that wants everything in one
# request rather than one per page.
bundle:
    okf-assemble --tarball
